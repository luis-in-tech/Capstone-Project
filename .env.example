# VITE_SUPABASE_URL: Public Supabase project URL (e.g. https://your-project-ref.supabase.co)
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"

# VITE_SUPABASE_ANON_KEY: Supabase publishable/anon key (with strict RLS policies enabled in Supabase)
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# VITE_GEMINI_API_KEY: Optional Gemini API key used by AI Pricelist scanner (keep empty in production if proxied)
VITE_GEMINI_API_KEY=""

# APP_URL: The URL where this app is hosted (self-referential links, OAuth redirects)
APP_URL="http://localhost:5173"
