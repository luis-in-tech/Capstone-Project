# ─────────────────────────────────────────────
#  Anti Gravity Backend — Environment Variables
#  Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────

# Server
PORT=4000
NODE_ENV=development

# PostgreSQL connection string (Prisma)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:change-me-local-db-password@localhost:5432/anti_gravity?schema=public"

# Path to the frontend project root that the agent will manage (relative to backend/ or absolute).
# The agent can ONLY read/write files inside this directory.
# Default when omitted: the parent of this backend/ folder
FRONTEND_ROOT=".."

# Secret key for validating API RBAC requests (required for admin/cmo/secretary routes in non-test environments)
API_SECRET="change-me-to-a-random-256-bit-secret"

# CORS origin(s) allowed to reach this backend (comma-separated)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
